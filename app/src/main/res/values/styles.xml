<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style
        name="Theme.ExynosBess"
        parent="Theme.Material3.Dark.NoActionBar">

        <item name="android:fontFamily">sans</item>

        <item name="colorPrimary">@color/exynos_accent</item>
        <item name="colorOnPrimary">@color/exynos_on_accent</item>

        <item name="colorPrimaryContainer">@color/exynos_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/exynos_on_primary_container</item>

        <item name="colorSurface">@color/exynos_surface</item>
        <item name="colorSurfaceVariant">@color/exynos_surface_2</item>

        <item name="colorOnSurface">@color/exynos_text</item>
        <item name="colorOnSurfaceVariant">@color/exynos_text_secondary</item>

        <item name="colorError">@color/exynos_error</item>

        <item name="android:windowBackground">@color/exynos_bg</item>

        <item name="android:statusBarColor">@color/exynos_bg</item>
        <item name="android:navigationBarColor">@color/exynos_bg</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:windowActionModeOverlay">true</item>

    </style>


    <!-- Cards principais -->

    <style name="Widget.GaspKernel.Card"
        parent="Widget.Material3.CardView.Filled">

        <item name="cardBackgroundColor">@color/exynos_surface_2</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>

        <item name="strokeColor">@color/exynos_border</item>
        <item name="strokeWidth">1dp</item>

        <item name="rippleColor">@color/exynos_primary_container</item>

    </style>


    <!-- Card tonal -->

    <style name="Widget.GaspKernel.Card.Tonal"
        parent="Widget.Material3.CardView.Filled">

        <item name="cardBackgroundColor">@color/exynos_surface_3</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>

    </style>


    <!-- Botão principal -->

    <style name="Widget.GaspKernel.Button.Primary"
        parent="Widget.Material3.Button">

        <item name="cornerRadius">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>

    </style>


    <!-- Botão secundário -->

    <style name="Widget.GaspKernel.Button.Secondary"
        parent="Widget.Material3.Button.TonalButton">

        <item name="cornerRadius">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>

    </style>


    <!-- Botão de perigo -->

    <style name="Widget.GaspKernel.Button.Danger"
        parent="Widget.Material3.Button">

        <item name="cornerRadius">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">54dp</item>

        <item name="backgroundTint">@color/exynos_error_container</item>
        <item name="android:textColor">@color/exynos_error</item>

    </style>

</resources>
