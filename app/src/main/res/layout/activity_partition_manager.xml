<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/exynos_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="26dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Partições"
            android:textColor="@color/exynos_text"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Selecione o que deseja modificar"
            android:textColor="@color/exynos_text_secondary"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/partitionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Detectando partições..."
            android:textColor="@color/exynos_accent"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/scanPartitionsButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Atualizar"
            android:textAllCaps="false"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp"
            android:text="BOOT"
            android:textColor="@color/exynos_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"/>

        <LinearLayout
            android:id="@+id/bootPartitionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="DEVICE TREE"
            android:textColor="@color/exynos_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"/>

        <LinearLayout
            android:id="@+id/dtbPartitionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="OVERLAYS"
            android:textColor="@color/exynos_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"/>

        <LinearLayout
            android:id="@+id/dtboPartitionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </LinearLayout>

</ScrollView>
