<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/exynos_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <!-- Cabeçalho -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/editorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DTS Editor"
            android:textColor="@color/exynos_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/editorPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/exynos_text_secondary"
            android:textSize="11sp" />

    </LinearLayout>


    <!-- Busca -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BUSCAR NO DEVICE TREE"
        android:textColor="@color/exynos_text_secondary"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_search_field"
        android:hint="Palavra, número, propriedade..."
        android:textColorHint="@color/exynos_text_secondary"
        android:textColor="@color/exynos_text"
        android:textColorHighlight="@color/exynos_accent"
        android:textCursorDrawable="@null"
        android:singleLine="true"
        android:inputType="text"
        android:textSize="14sp"
        android:fontFamily="sans"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />


    <!-- Controles de busca -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/searchButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:text="Buscar"
            android:textAllCaps="false"
            android:textColor="#081018"
            android:textStyle="bold"
            android:textSize="13sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp" />

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/searchNextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:text="Próximo"
            android:textAllCaps="false"
            android:textColor="@color/exynos_text"
            android:textSize="13sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:enabled="false" />

    </LinearLayout>

    <TextView
        android:id="@+id/searchStatus"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:text=""
        android:textColor="@color/exynos_accent"
        android:textSize="11sp" />


    <!-- Editor -->

    <EditText
        android:id="@+id/dtsEditor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_editor_panel"
        android:gravity="top|start"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textColor="@color/exynos_text"
        android:textColorHighlight="@color/exynos_accent"
        android:textColorHint="@color/exynos_text_secondary"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical|horizontal"
        android:fadeScrollbars="false"
        android:overScrollMode="always"
        android:padding="14dp"
        android:lineSpacingExtra="2dp"
        android:textCursorDrawable="@null" />


    <!-- Ações -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/saveDtsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:text="Salvar"
            android:textAllCaps="false"
            android:textColor="@color/exynos_text"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp" />

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/validateDtsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:text="Validar"
            android:textAllCaps="false"
            android:textColor="#081018"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/editorStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        android:gravity="center_vertical"
        android:text=""
        android:textColor="@color/exynos_text_secondary"
        android:textSize="11sp"
        android:layout_marginTop="4dp" />


        <!-- Fluxo pós-edição -->
        <LinearLayout
            android:id="@+id/bootActionsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PÓS-EDIÇÃO"
                android:textColor="@color/exynos_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/bootActionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="✓ DTS validado"
                android:textColor="@color/exynos_text"
                android:textSize="12sp" />

            <Button
                android:id="@+id/rebuildFromEditorButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary"
                android:text="1. Gerar novo boot"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#081018" />

            <Button
                android:id="@+id/verifyFromEditorButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_secondary"
                android:enabled="false"
                android:text="2. Verificar boot"
                android:textAllCaps="false"
                android:textColor="@color/exynos_text" />

            <Button
                android:id="@+id/flashFromEditorButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_secondary"
                android:enabled="false"
                android:text="3. Flash boot"
                android:textAllCaps="false"
                android:textColor="@color/exynos_text" />

        </LinearLayout>

</LinearLayout>
