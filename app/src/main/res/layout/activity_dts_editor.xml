<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/exynos_bg"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">


    <!-- Cabeçalho compacto -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/editorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DTS 0"
                android:textColor="@color/exynos_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/editorPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/exynos_text_secondary"
                android:textSize="8sp"
                android:maxLines="1"
                android:ellipsize="middle" />

        </LinearLayout>


        <Button
            android:id="@+id/numericBaseButton"
            android:layout_width="54dp"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_button_secondary"
            android:text="DEC"
            android:textAllCaps="false"
            android:textColor="@color/exynos_accent"
            android:textSize="9sp"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveDtsButton"
            android:layout_width="68dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/action_save"
            android:textAllCaps="false"
            android:textColor="@color/exynos_text"
            android:textSize="10sp"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/validateDtsButton"
            android:layout_width="70dp"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/action_validate"
            android:textAllCaps="false"
            android:textColor="#081018"
            android:textSize="10sp"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp" />

    </LinearLayout>


    <!-- Busca compacta -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_field"
            android:hint="Buscar no DTS..."
            android:textColorHint="@color/exynos_text_secondary"
            android:textColor="@color/exynos_text"
            android:textColorHighlight="@color/exynos_accent"
            android:textCursorDrawable="@null"
            android:singleLine="true"
            android:inputType="text"
            android:textSize="11sp"
            android:paddingStart="10dp"
            android:paddingEnd="8dp" />


        <Button
            android:id="@+id/searchButton"
            android:layout_width="54dp"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/action_go"
            android:textAllCaps="false"
            android:textColor="#081018"
            android:textSize="10sp"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp" />


        <Button
            android:id="@+id/searchNextButton"
            android:layout_width="54dp"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/action_next"
            android:textAllCaps="false"
            android:textColor="@color/exynos_text"
            android:textSize="9sp"
            android:enabled="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp" />

    </LinearLayout>


    <TextView
        android:id="@+id/searchStatus"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:gravity="center_vertical"
        android:text=""
        android:textColor="@color/exynos_accent"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end" />


    <!-- Editor: ocupa todo o espaço disponível -->


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/EditorUndoButton"
            android:layout_width="42dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_button_secondary"
            android:text="↶"
            android:textColor="@color/exynos_text"
            android:textSize="17sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/EditorRedoButton"
            android:layout_width="42dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_button_secondary"
            android:text="↷"
            android:textColor="@color/exynos_text"
            android:textSize="17sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/EditorGotoButton"
            android:layout_width="46dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/editor_goto"
            android:textAllCaps="false"
            android:textColor="@color/exynos_text"
            android:textSize="9sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/EditorFontDownButton"
            android:layout_width="38dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_button_secondary"
            android:text="A−"
            android:textAllCaps="false"
            android:textColor="@color/exynos_text"
            android:textSize="9sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/EditorFontUpButton"
            android:layout_width="38dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_button_secondary"
            android:text="A+"
            android:textAllCaps="false"
            android:textColor="@color/exynos_text"
            android:textSize="9sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/EditorDiffButton"
            android:layout_width="42dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/diff_button"
            android:textAllCaps="false"
            android:textColor="@color/exynos_text"
            android:textSize="9sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"/>

        <TextView
            android:id="@+id/EditorPositionStatus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            android:text=""
            android:textColor="@color/exynos_text_secondary"
            android:textSize="9sp"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/EditorDirtyStatus"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:text=""
            android:textColor="@color/exynos_accent"
            android:textSize="9sp"
            android:maxLines="1"/>

    </LinearLayout>

    <com.exynosbess.app.editor.CodeEditorView
        android:id="@+id/dtsEditor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_editor_panel"
        android:gravity="top|start"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textColor="@color/exynos_text"
        android:textColorHighlight="@color/exynos_accent"
        android:textColorHint="@color/exynos_text_secondary"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical|horizontal"
        android:fadeScrollbars="false"
        android:overScrollMode="always"
        android:padding="9dp"
        android:lineSpacingExtra="1dp"
        android:textCursorDrawable="@null" />


    <!-- Status do editor -->

    <TextView
        android:id="@+id/editorStatus"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:text=""
        android:textColor="@color/exynos_text_secondary"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end" />


    <!-- Pós-edição compacto -->

</LinearLayout>
