<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/editorTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Editor DTS"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/editorPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/dtsEditor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top|start"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical|horizontal"
        android:overScrollMode="always"
        android:padding="8dp" />

    <Button
        android:id="@+id/saveDtsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Salvar DTS"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/validateDtsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Validar DTS"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/editorStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:layout_marginTop="8dp" />

</LinearLayout>
