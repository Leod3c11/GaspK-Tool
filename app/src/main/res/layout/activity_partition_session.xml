<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/exynos_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="26dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">


        <TextView
            android:id="@+id/partitionSessionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device Tree"
            android:textColor="@color/exynos_text"
            android:textSize="30sp"
            android:textStyle="bold"/>


        <TextView
            android:id="@+id/partitionSessionType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/exynos_accent"
            android:textSize="13sp"
            android:textStyle="bold"/>


        <!-- STATUS PRINCIPAL -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_dashboard_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS"
                android:textColor="@color/exynos_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"/>

            <TextView
                android:id="@+id/partitionSessionState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Partição encontrada"
                android:textColor="@color/exynos_text"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp"/>

        </LinearLayout>


        <!-- FLUXO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp"
            android:text="EDIÇÃO"
            android:textColor="@color/exynos_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"/>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/partitionPrepareButton"
            style="@style/Widget.GaspKernel.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Preparar partição"
            android:textAllCaps="false"
            android:textSize="15sp"/>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/partitionEditButton"
            style="@style/Widget.GaspKernel.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="Editar Device Trees"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:visibility="gone"/>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/partitionApplyButton"
            style="@style/Widget.GaspKernel.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="Aplicar alterações"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:visibility="gone"/>


        <!-- RESULTADO -->

        <LinearLayout
            android:id="@+id/partitionReadyActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="10dp"
                android:text="IMAGEM MODIFICADA"
                android:textColor="@color/exynos_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"/>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/partitionExportButton"
                style="@style/Widget.GaspKernel.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Exportar imagem"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:visibility="gone"/>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/partitionFlashButton"
                style="@style/Widget.GaspKernel.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:text="Instalar modificação"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"/>

        </LinearLayout>


        <!-- DETALHES TÉCNICOS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="10dp"
            android:text="DETALHES"
            android:textColor="@color/exynos_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dashboard_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Partição"
                android:textColor="@color/exynos_text_secondary"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/partitionSessionSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/exynos_text"
                android:textSize="11sp"/>

        </LinearLayout>


    </LinearLayout>

</ScrollView>
