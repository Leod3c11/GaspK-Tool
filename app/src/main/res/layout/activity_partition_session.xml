<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/exynos_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/partitionSessionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/exynos_text"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/partitionSessionType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/exynos_accent"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_dashboard_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ORIGEM"
                android:textColor="@color/exynos_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/partitionSessionSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/exynos_text"
                android:textSize="12sp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dashboard_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESTADO"
                android:textColor="@color/exynos_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/partitionSessionState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/exynos_text"
                android:textSize="13sp"/>

        </LinearLayout>

        <Button
            android:id="@+id/partitionImportButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="Importar partição"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/partitionExtractButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Extrair / descompactar"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/partitionEditButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Editar Device Trees"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/partitionValidateButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Validar alterações"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/partitionRebuildButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Reconstruir"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/partitionVerifyButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Verificar reconstrução"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/partitionExportButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="Exportar arquivo modificado"
            android:textAllCaps="false"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="ZONA DE RISCO"
            android:textColor="#B36B75"
            android:textSize="10sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/partitionFlashButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_advanced_card_danger"
            android:text="Flash"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>

    </LinearLayout>

</ScrollView>
