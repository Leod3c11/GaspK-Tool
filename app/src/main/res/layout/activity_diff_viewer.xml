<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/exynos_background"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/diff_title"
        android:textColor="@color/exynos_text"
        android:textStyle="bold"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/diffSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:textColor="@color/exynos_text_secondary"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/diffText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="900dp"
                android:padding="8dp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textColor="@color/exynos_text"
                android:textSize="11sp" />

        </ScrollView>

    </HorizontalScrollView>

</LinearLayout>
