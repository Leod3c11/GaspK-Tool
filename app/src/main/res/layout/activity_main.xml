<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D10"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="40dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_advanced_header"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GASP"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="KERNEL EDITOR"
                android:textColor="#8B96A5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Ferramentas avançadas"
                android:textColor="#E4E8ED"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Controle manual do boot e Device Tree"
                android:textColor="#7F8996"
                android:textSize="14sp"/>

        </LinearLayout>

        <!-- ROOT -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="9dp"
            android:text="01  ACESSO AO SISTEMA"
            android:textColor="#697586"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_advanced_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/rootStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Root ainda não verificado."
                android:textColor="#E7EAEE"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/rootOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text=""
                android:textColor="#8E98A5"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/checkRootButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="15dp"
                android:backgroundTint="#2E6EF7"
                android:text="VERIFICAR ACESSO ROOT"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- BOOT SOURCE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="9dp"
            android:text="02  BOOT ORIGINAL"
            android:textColor="#697586"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_advanced_card"
            android:orientation="vertical"
            android:padding="18dp">

            <Button
                android:id="@+id/detectBootButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#252B34"
                android:enabled="false"
                android:text="Detectar partição boot"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/bootStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textColor="#919BA7"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/backupBootButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#252B34"
                android:enabled="false"
                android:text="Criar backup do boot.img"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/backupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textColor="#919BA7"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/unpackBootButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#252B34"
                android:enabled="false"
                android:text="Descompactar boot.img"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/unpackStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textColor="#919BA7"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- DEVICE TREE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="9dp"
            android:text="03  DEVICE TREE"
            android:textColor="#697586"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_advanced_card"
            android:orientation="vertical"
            android:padding="18dp">

            <Button
                android:id="@+id/scanDtbButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#252B34"
                android:enabled="false"
                android:text="Procurar Device Trees"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/dtbScanStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text=""
                android:textColor="#919BA7"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/extractDtbButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#252B34"
                android:enabled="false"
                android:text="Extrair DTBs"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/dtbExtractStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text=""
                android:textColor="#919BA7"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/decompileDtbButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#252B34"
                android:enabled="false"
                android:text="Converter DTB → DTS"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/decompileDtbStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text=""
                android:textColor="#919BA7"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- DTS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="9dp"
            android:text="04  EDITAR DEVICE TREE"
            android:textColor="#697586"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_advanced_card"
            android:orientation="vertical"
            android:padding="18dp">

            <Button
                android:id="@+id/openDts0Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#252B34"
                android:enabled="false"
                android:text="Abrir DTS 0"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/openDts1Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#252B34"
                android:enabled="false"
                android:text="Abrir DTS 1"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- BUILD -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="9dp"
            android:text="05  BUILD PIPELINE"
            android:textColor="#697586"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_advanced_card"
            android:orientation="vertical"
            android:padding="18dp">

            <Button
                android:id="@+id/rebuildBootButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#2E6EF7"
                android:enabled="false"
                android:text="Gerar boot_modified.img"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/rebuildBootStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textColor="#919BA7"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/verifyRoundTripButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="13dp"
                android:backgroundTint="#252B34"
                android:enabled="false"
                android:text="Verificar boot reconstruído"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/roundTripStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textColor="#919BA7"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- FLASH -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="9dp"
            android:text="06  INSTALAÇÃO"
            android:textColor="#9A6870"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_advanced_card_danger"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Flash da partição boot"
                android:textColor="#F1E8EA"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="A imagem só deve ser instalada depois de passar pela verificação final."
                android:textColor="#AA888E"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/flashBootButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#B83A4B"
                android:enabled="false"
                android:text="Instalar boot modificado"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/flashBootStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text=""
                android:textColor="#C8A7AD"
                android:textSize="13sp"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="GASP KERNEL EDITOR"
            android:textColor="#434A54"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"/>

    </LinearLayout>

</ScrollView>
