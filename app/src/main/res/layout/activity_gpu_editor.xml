<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/exynos_bg"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GPU"
                android:textColor="@color/exynos_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gpuEditorSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Carregando..."
                android:textColor="@color/exynos_text_secondary"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <Button
            android:id="@+id/gpuNumericBaseButton"
            android:layout_width="54dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_button_secondary"
            android:text="DEC"
            android:textAllCaps="false"
            android:textColor="@color/exynos_text"
            android:textSize="10sp"
            android:padding="0dp" />

        <Button
            android:id="@+id/gpuPreviousDtbButton"
            android:layout_width="42dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_button_secondary"
            android:text="‹"
            android:textColor="@color/exynos_text"
            android:textSize="18sp"
            android:padding="0dp" />

        <Button
            android:id="@+id/gpuNextDtbButton"
            android:layout_width="42dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_button_secondary"
            android:text="›"
            android:textColor="@color/exynos_text"
            android:textSize="18sp"
            android:padding="0dp" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/gpuSearchInput"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_field"
            android:hint="Buscar propriedade..."
            android:singleLine="true"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/exynos_text"
            android:textColorHint="@color/exynos_text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/gpuSearchButton"
            android:layout_width="54dp"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_button_secondary"
            android:text="Ir"
            android:textAllCaps="false"
            android:textColor="@color/exynos_text"
            android:textSize="11sp" />

        <Button
            android:id="@+id/gpuSearchNextButton"
            android:layout_width="62dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_button_secondary"
            android:text="Próx."
            android:textAllCaps="false"
            android:textColor="@color/exynos_text"
            android:textSize="11sp" />

    </LinearLayout>


    <TextView
        android:id="@+id/gpuSearchStatus"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:gravity="center_vertical"
        android:text=""
        android:textColor="@color/exynos_text_secondary"
        android:textSize="9sp" />


    <EditText
        android:id="@+id/gpuNodeEditor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_editor_panel"
        android:gravity="top|start"
        android:fontFamily="monospace"
        android:inputType="textMultiLine|textNoSuggestions"
        android:padding="9dp"
        android:scrollbars="vertical|horizontal"
        android:overScrollMode="always"
        android:textColor="@color/exynos_text"
        android:textSize="11sp" />


    <TextView
        android:id="@+id/gpuEditorStatus"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text=""
        android:textColor="@color/exynos_text_secondary"
        android:textSize="10sp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/gpuSaveButton"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:text="Salvar"
            android:textAllCaps="false"
            android:textColor="@color/exynos_text"
            android:textSize="10sp" />

        <Button
            android:id="@+id/gpuValidateButton"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:text="Validar"
            android:textAllCaps="false"
            android:textColor="@color/exynos_text"
            android:textSize="10sp" />

        <Button
            android:id="@+id/gpuRebuildButton"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:enabled="false"
            android:text="Gerar"
            android:textAllCaps="false"
            android:textColor="@color/exynos_text"
            android:textSize="10sp" />

        <Button
            android:id="@+id/gpuVerifyButton"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:enabled="false"
            android:text="Verificar"
            android:textAllCaps="false"
            android:textColor="@color/exynos_text"
            android:textSize="10sp" />

        <Button
            android:id="@+id/gpuFlashButton"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:enabled="false"
            android:text="Flash"
            android:textAllCaps="false"
            android:textColor="#081018"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
