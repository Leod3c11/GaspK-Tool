<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#26303B" />
            <stroke
                android:width="1dp"
                android:color="@color/exynos_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="@color/exynos_surface_2" />
            <stroke
                android:width="1dp"
                android:color="@color/exynos_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>

</selector>
